<?xml version="1.0" encoding="utf-8"?>
<!--
    The sky the application generates for a sun 55 degrees above the horizon,
    which is roughly noon in Turkey in summer. The colours are the daylight stop
    from SkyPaletteFactory rather than a separate set chosen to look similar: an
    icon drawn from different values would drift away from the screen it opens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF1466C6" />
                <item android:offset="0.75" android:color="#FF4E9BDD" />
                <item android:offset="1" android:color="#FF8FC3EE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
