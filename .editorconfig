# One answer for whitespace, so that a diff never contains a change nobody made.
#
# The two machines this project is built on disagree about line endings by
# default. .gitattributes settles what is stored; this settles what is typed.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset

[*.{xml,yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so they are not whitespace
# to be tidied away.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf

[Makefile]
indent_style = tab
